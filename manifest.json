{
  "manifest_version": 3,
  "name": "Tilde",
  "version": "0.7.0",
  "description": "A terminal-styled new tab page: every saved site on one screen, and a prompt for search, URLs, and commands.",
  "chrome_url_overrides": { "newtab": "tilde.html" },
  "permissions": ["favicon", "search", "storage"],
  "optional_host_permissions": ["https://icons.duckduckgo.com/*"],
  "key": ""
}
